---
import profile from '../data/profile.json';
---

<header class="profile">
	<figure class="portrait">
		<img class="avatar" src={profile.avatar} alt="" width="220" height="220" />
		{
			profile.status.length > 0 && (
				<figcaption>
					{profile.status.map((line) => (
						<span>{line}</span>
					))}
				</figcaption>
			)
		}
	</figure>
	<div>
		<h1>{profile.name}</h1>
		<p class="tagline">{profile.tagline}</p>
		<ul class="contacts">
			{
				profile.links.map((link) => (
					<li>
						<a href={link.url}>
							{link.icon && <span class="icon" style={`--icon: url(${link.icon})`} aria-hidden="true" />}
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</header>
